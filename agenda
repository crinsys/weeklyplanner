<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Agenda de la semaine</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
            background: #ffffff;
            min-height: 100vh;
            padding: 20px;
            color: #000000;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
        }

        .top-nav {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-bottom: 20px;
        }

        .nav-btn {
            padding: 10px 20px;
            background: #000000;
            color: white;
            border: 2px solid #000000;
            cursor: pointer;
            font-size: 1em;
            font-weight: 500;
            transition: all 0.2s;
            text-decoration: none;
            display: inline-block;
        }

        .nav-btn:hover {
            background: #333333;
            border-color: #333333;
        }

        .nav-btn.secondary {
            background: white;
            color: #000000;
        }

        .nav-btn.secondary:hover {
            background: #f5f5f5;
        }

        header {
            text-align: left;
            margin-bottom: 0;
            background: #f5f5f5;
            padding: 30px 20px 20px 20px;
        }

        h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
            color: #000000;
            font-weight: 600;
        }

        header p {
            color: #666666;
            font-size: 1em;
        }

        .loading {
            text-align: center;
            padding: 40px;
            color: #666666;
            font-size: 1.2em;
        }

        .week-nav {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 20px;
            margin-bottom: 30px;
            background: #f5f5f5;
            padding: 20px;
        }

        .week-nav button {
            background: white;
            border: 2px solid #000000;
            padding: 10px 20px;
            cursor: pointer;
            font-size: 1em;
            font-weight: 500;
            color: #000000;
            transition: all 0.2s;
        }

        .week-nav button:hover {
            background: #000000;
            color: #ffffff;
        }

        .week-info {
            color: #000000;
            font-size: 1.2em;
            font-weight: 600;
        }

        .filter-bar {
            display: flex;
            justify-content: flex-start;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 20px;
            padding: 0 20px;
        }

        .filter-all-btn,
        .category-filter {
            background: white;
            border: 1px solid #e0e0e0;
            padding: 6px 12px;
            cursor: pointer;
            font-size: 0.85em;
            font-weight: 400;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 6px;
            color: #666666;
        }

        .filter-all-btn:hover,
        .category-filter:hover {
            border-color: #999999;
        }

        .all-color-square {
            width: 12px;
            height: 12px;
            background: #999999;
            border: 1px solid #999999;
            transition: all 0.2s;
        }

        .filter-all-btn.all-active {
            border-color: #000000;
            color: #000000;
        }

        .filter-all-btn.all-active .all-color-square {
            background: #000000;
            border-color: #000000;
        }

        .filter-all-btn:not(.all-active) .all-color-square {
            background: transparent;
            border-color: #999999;
        }

        .category-color-square {
            width: 12px;
            height: 12px;
            transition: all 0.2s;
        }

        .category-filter.active {
            border-color: var(--cat-color);
            color: #000000;
        }

        .category-filter.active .category-color-square {
            background: var(--cat-color);
            border: 1px solid var(--cat-color);
        }

        .category-filter.inactive {
            border-color: #e0e0e0;
            color: #666666;
        }

        .category-filter.inactive .category-color-square {
            background: transparent;
            border: 1px solid var(--cat-color);
        }

        .calendar-grid {
            display: flex;
            gap: 15px;
            margin-bottom: 30px;
            flex-wrap: wrap;
        }

        .day-column {
            background: white;
            padding: 15px;
            border: 2px solid #000000;
            min-height: 400px;
            display: flex;
            flex-direction: column;
            transition: all 0.3s ease;
        }

        .day-column.has-events {
            flex: 1.3;
            min-width: 200px;
        }

        .day-column.empty {
            flex: 0.7;
            min-width: 130px;
        }

        .day-header {
            text-align: center;
            padding: 10px;
            background: #000000;
            color: #ffffff;
            margin-bottom: 15px;
        }

        .day-name {
            font-size: 1.2em;
            font-weight: 600;
            color: #ffffff;
        }

        .day-date {
            font-size: 0.9em;
            color: #cccccc;
        }

        .events-list {
            flex: 1;
            overflow-y: auto;
        }

        .event-card {
            background: #f5f5f5;
            border-left: 4px solid #000000;
            padding: 12px;
            margin-bottom: 10px;
            transition: all 0.2s;
            cursor: pointer;
        }

        .event-card.hidden {
            display: none;
        }

        .event-card:hover {
            background: #e8e8e8;
            transform: translateX(3px);
        }

        .event-time {
            font-weight: 600;
            color: #000000;
            font-size: 0.9em;
            margin-bottom: 5px;
        }

        .event-title {
            font-weight: 600;
            margin-bottom: 5px;
            color: #000000;
        }

        .event-location {
            font-size: 0.85em;
            color: #666666;
            margin-bottom: 5px;
        }

        .event-description {
            font-size: 0.85em;
            color: #666666;
            overflow: hidden;
            text-overflow: ellipsis;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            line-height: 1.4em;
            max-height: 2.8em;
        }

        .event-tooltip {
            display: none;
            position: fixed;
            background: white;
            border: 2px solid #000000;
            padding: 20px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.2);
            z-index: 1000;
            max-width: 400px;
            min-width: 300px;
            pointer-events: none;
        }

        .event-tooltip.active {
            display: block;
        }

        .tooltip-time {
            font-weight: 600;
            color: #000000;
            font-size: 1.1em;
            margin-bottom: 10px;
        }

        .tooltip-title {
            font-weight: 600;
            font-size: 1.2em;
            margin-bottom: 10px;
            color: #000000;
        }

        .tooltip-location {
            font-size: 1em;
            color: #666666;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .tooltip-description {
            font-size: 1em;
            color: #333333;
            line-height: 1.6;
            white-space: pre-wrap;
        }

        .empty-message {
            text-align: center;
            color: #999999;
            font-style: italic;
            padding: 20px;
        }

        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            z-index: 2000;
            align-items: center;
            justify-content: center;
        }

        .modal.active {
            display: flex;
        }

        .modal-content {
            background: white;
            padding: 30px;
            width: 90%;
            max-width: 400px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.3);
            border: 2px solid #000000;
        }

        .modal-header {
            font-size: 1.5em;
            margin-bottom: 20px;
            color: #000000;
            font-weight: 600;
        }

        .form-group {
            margin-bottom: 15px;
        }

        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-weight: 600;
            color: #000000;
        }

        .form-group input {
            width: 100%;
            padding: 10px;
            border: 2px solid #cccccc;
            font-size: 1em;
            font-family: inherit;
        }

        .form-group input:focus {
            outline: none;
            border-color: #000000;
        }

        .modal-buttons {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }

        .modal-buttons button {
            flex: 1;
            padding: 12px;
            border: none;
            cursor: pointer;
            font-size: 1em;
            font-weight: 500;
            transition: all 0.2s;
        }

        .btn-submit {
            background: #000000;
            color: white;
        }

        .btn-submit:hover {
            background: #333333;
        }

        .btn-cancel {
            background: #cccccc;
            color: #000000;
        }

        .btn-cancel:hover {
            background: #b3b3b3;
        }

        .error-message {
            color: #dc2626;
            font-size: 0.9em;
            margin-top: 5px;
        }

        @media (max-width: 1200px) {
            .day-column.has-events {
                flex: 1.2;
                min-width: 180px;
            }

            .day-column.empty {
                flex: 0.8;
                min-width: 110px;
            }
        }

        @media (max-width: 900px) {
            .calendar-grid {
                flex-direction: column;
            }

            .day-column.has-events,
            .day-column.empty {
                flex: 1;
                width: 100%;
                min-width: auto;
            }

            .filter-bar {
                gap: 6px;
            }

            .filter-all-btn,
            .category-filter {
                font-size: 0.8em;
                padding: 5px 10px;
            }

            .all-color-square,
            .category-color-square {
                width: 10px;
                height: 10px;
            }

            .top-nav {
                flex-direction: column;
            }

            .nav-btn {
                width: 100%;
            }
        }

        @media (max-width: 768px) {
            h1 {
                font-size: 1.8em;
            }

            .week-nav {
                flex-direction: column;
                gap: 10px;
            }

            .week-nav button {
                width: 100%;
            }

            .event-tooltip {
                max-width: calc(100vw - 40px);
                min-width: auto;
            }
        }

        @media (max-width: 600px) {
            body {
                padding: 10px;
            }

            .day-column {
                min-height: 300px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="top-nav">
            <button class="nav-btn secondary" onclick="showPasswordModal()">✏️ Éditer</button>
            <a href="generator-social-media.html" class="nav-btn">📱 Partager réseaux sociaux</a>
        </div>

        <header>
            <h1>Agenda de la semaine</h1>
            <p></p>
        </header>

        <div class="loading" id="loading">Chargement des événements...</div>

        <div id="mainContent" style="display: none;">
            <div class="week-nav">
                <button onclick="changeWeek(-1)">← Semaine précédente</button>
                <div class="week-info" id="weekInfo"></div>
                <button onclick="changeWeek(1)">Semaine suivante →</button>
            </div>

            <div class="filter-bar">
                <button class="filter-all-btn all-active" id="filterAllBtn" onclick="toggleAllCategories()">
                    <div class="all-color-square"></div>
                    <span>Tout</span>
                </button>
                <div id="categoryFilters" style="display: flex; gap: 8px; flex-wrap: wrap;"></div>
            </div>

            <div class="calendar-grid" id="calendar"></div>
        </div>
    </div>

    <div class="event-tooltip" id="eventTooltip"></div>

    <div class="modal" id="passwordModal">
        <div class="modal-content">
            <h2 class="modal-header">Accès à l'édition</h2>
            <div class="form-group">
                <label for="passwordInput">Mot de passe</label>
                <input type="password" id="passwordInput" placeholder="Entrez le mot de passe">
                <div class="error-message" id="errorMessage" style="display: none;">Mot de passe incorrect</div>
            </div>
            <div class="modal-buttons">
                <button class="btn-submit" onclick="checkPassword()">Valider</button>
                <button class="btn-cancel" onclick="closePasswordModal()">Annuler</button>
            </div>
        </div>
    </div>

    <script>
        const CONFIG = {
            apiKey: '$2a$10$my3e9Iq89J.e6ZbnhnWIwOwVd9ISyw7zmnOmVlKE672q14u4u6np2',
            binId: '6916edddd0ea881f40e7af4a'
        };
        
        let currentWeekOffset = 0;
        let events = {};
        let activeCategories = new Set();

        const categories = [
            { id: 'manifestation', name: 'Manifestation', color: '#FFB5BA' },
            { id: 'reunion', name: 'Réunion', color: '#B5D5FF' },
            { id: 'action', name: 'Action', color: '#B5FFB5' },
            { id: 'formation', name: 'Formation', color: '#FFE5B5' },
            { id: 'ag', name: 'Assemblée Générale', color: '#E5B5FF' },
            { id: 'evenement', name: 'Événement', color: '#FFD5E5' }
        ];

        const daysOfWeek = ['Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi', 'Dimanche'];

        function showPasswordModal() {
            document.getElementById('passwordModal').classList.add('active');
            document.getElementById('passwordInput').value = '';
            document.getElementById('errorMessage').style.display = 'none';
            document.getElementById('passwordInput').focus();
        }

        function closePasswordModal() {
            document.getElementById('passwordModal').classList.remove('active');
        }

        function checkPassword() {
            const password = document.getElementById('passwordInput').value;
            if (password === 'amiens') {
                window.location.href = 'admin-programme.html';
            } else {
                document.getElementById('errorMessage').style.display = 'block';
                document.getElementById('passwordInput').value = '';
                document.getElementById('passwordInput').focus();
            }
        }

        document.getElementById('passwordInput').addEventListener('keypress', (e) => {
            if (e.key === 'Enter') {
                checkPassword();
            }
        });

        async function loadEvents() {
            try {
                const response = await fetch(`https://api.jsonbin.io/v3/b/${CONFIG.binId}/latest`, {
                    headers: {
                        'X-Master-Key': CONFIG.apiKey
                    }
                });
                const data = await response.json();
                events = data.record.events || {};
                document.getElementById('loading').style.display = 'none';
                document.getElementById('mainContent').style.display = 'block';
                initCategoryFilters();
                renderCalendar();
            } catch (error) {
                console.error('Erreur chargement:', error);
                document.getElementById('loading').textContent = 'Erreur de chargement. Rechargez la page.';
            }
        }

        function initCategoryFilters() {
            const container = document.getElementById('categoryFilters');
            container.innerHTML = '';
            
            categories.forEach(cat => {
                activeCategories.add(cat.id);
                
                const button = document.createElement('button');
                button.className = 'category-filter active';
                button.style.setProperty('--cat-color', cat.color);
                button.setAttribute('data-category', cat.id);
                button.innerHTML = `
                    <div class="category-color-square"></div>
                    <span>${cat.name}</span>
                `;
                
                button.addEventListener('click', () => toggleCategory(cat.id));
                container.appendChild(button);
            });
        }

        function toggleCategory(categoryId) {
            const button = document.querySelector(`[data-category="${categoryId}"]`);
            
            if (activeCategories.has(categoryId)) {
                activeCategories.delete(categoryId);
                button.classList.remove('active');
                button.classList.add('inactive');
            } else {
                activeCategories.add(categoryId);
                button.classList.remove('inactive');
                button.classList.add('active');
            }
            
            updateAllButtonState();
            updateVisibleEvents();
        }

        function toggleAllCategories() {
            const allActive = activeCategories.size === categories.length;
            
            if (allActive) {
                activeCategories.clear();
                document.querySelectorAll('.category-filter').forEach(btn => {
                    btn.classList.remove('active');
                    btn.classList.add('inactive');
                });
            } else {
                categories.forEach(cat => activeCategories.add(cat.id));
                document.querySelectorAll('.category-filter').forEach(btn => {
                    btn.classList.remove('inactive');
                    btn.classList.add('active');
                });
            }
            
            updateAllButtonState();
            updateVisibleEvents();
        }

        function updateAllButtonState() {
            const allBtn = document.getElementById('filterAllBtn');
            if (activeCategories.size === categories.length) {
                allBtn.classList.add('all-active');
            } else {
                allBtn.classList.remove('all-active');
            }
        }

        function updateVisibleEvents() {
            document.querySelectorAll('.event-card').forEach(card => {
                const category = card.getAttribute('data-category');
                if (activeCategories.has(category)) {
                    card.classList.remove('hidden');
                } else {
                    card.classList.add('hidden');
                }
            });
            
            document.querySelectorAll('.day-column').forEach(column => {
                const eventsList = column.querySelector('.events-list');
                const visibleEvents = eventsList.querySelectorAll('.event-card:not(.hidden)');
                
                if (visibleEvents.length === 0 && eventsList.children.length > 0) {
                    if (!eventsList.querySelector('.empty-message')) {
                        eventsList.innerHTML = '<div class="empty-message">Aucun événement visible</div>';
                    }
                } else if (visibleEvents.length > 0) {
                    const emptyMsg = eventsList.querySelector('.empty-message');
                    if (emptyMsg) {
                        emptyMsg.remove();
                    }
                }
            });
        }

        function getCategoryColor(categoryId) {
            const category = categories.find(cat => cat.id === categoryId);
            return category ? category.color : '#000000';
        }

        function getWeekDates(offset) {
            const today = new Date();
            const currentDay = today.getDay();
            const monday = new Date(today);
            monday.setDate(today.getDate() - (currentDay === 0 ? 6 : currentDay - 1) + (offset * 7));
            
            const dates = [];
            for (let i = 0; i < 7; i++) {
                const date = new Date(monday);
                date.setDate(monday.getDate() + i);
                dates.push(date);
            }
            return dates;
        }

        function formatDate(date) {
            return date.toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit' });
        }

        function getDateKey(date) {
            return date.toISOString().split('T')[0];
        }

        function renderCalendar() {
            const dates = getWeekDates(currentWeekOffset);
            const calendar = document.getElementById('calendar');
            calendar.innerHTML = '';

            const firstDate = dates[0];
            const lastDate = dates[6];
            document.getElementById('weekInfo').textContent = 
                `Semaine du ${formatDate(firstDate)} au ${formatDate(lastDate)}`;

            dates.forEach((date, index) => {
                const dateKey = getDateKey(date);
                const dayEvents = events[dateKey] || [];
                const hasEvents = dayEvents.length > 0;

                const dayColumn = document.createElement('div');
                dayColumn.className = `day-column ${hasEvents ? 'has-events' : 'empty'}`;
                dayColumn.innerHTML = `
                    <div class="day-header">
                        <div class="day-name">${daysOfWeek[index]}</div>
                        <div class="day-date">${formatDate(date)}</div>
                    </div>
                    <div class="events-list" id="events-${dateKey}"></div>
                `;
                calendar.appendChild(dayColumn);

                renderEvents(dateKey);
            });
        }

        function renderEvents(dateKey) {
            const eventsList = document.getElementById(`events-${dateKey}`);
            if (!eventsList) return;

            const dayEvents = events[dateKey] || [];
            eventsList.innerHTML = '';

            if (dayEvents.length === 0) {
                eventsList.innerHTML = '<div class="empty-message">Aucun événement</div>';
                return;
            }

            dayEvents.sort((a, b) => a.time.localeCompare(b.time));

            dayEvents.forEach((event, index) => {
                const borderColor = event.category ? getCategoryColor(event.category) : '#000000';
                const eventCard = document.createElement('div');
                eventCard.className = 'event-card';
                eventCard.setAttribute('data-category', event.category || 'none');
                eventCard.style.borderLeftColor = borderColor;
                
                if (!activeCategories.has(event.category)) {
                    eventCard.classList.add('hidden');
                }
                
                eventCard.innerHTML = `
                    <div class="event-time">${event.time}</div>
                    <div class="event-title">${event.title}</div>
                    ${event.location ? `<div class="event-location">📍 ${event.location}</div>` : ''}
                    ${event.description ? `<div class="event-description">${event.description}</div>` : ''}
                `;
                
                eventCard.addEventListener('mouseenter', (e) => showTooltip(e, event));
                eventCard.addEventListener('mouseleave', hideTooltip);
                eventCard.addEventListener('mousemove', updateTooltipPosition);
                
                eventsList.appendChild(eventCard);
            });
            
            updateVisibleEvents();
        }

        function showTooltip(e, event) {
            const tooltip = document.getElementById('eventTooltip');
            tooltip.innerHTML = `
                <div class="tooltip-time">🕐 ${event.time}</div>
                <div class="tooltip-title">${event.title}</div>
                ${event.location ? `<div class="tooltip-location">📍 ${event.location}</div>` : ''}
                ${event.description ? `<div class="tooltip-description">${event.description}</div>` : ''}
            `;
            tooltip.classList.add('active');
            tooltip.style.pointerEvents = 'none';
            updateTooltipPosition(e);
        }

        function hideTooltip() {
            const tooltip = document.getElementById('eventTooltip');
            tooltip.classList.remove('active');
            tooltip.style.display = 'none';
        }

        function updateTooltipPosition(e) {
            const tooltip = document.getElementById('eventTooltip');
            if (!tooltip.classList.contains('active')) return;

            tooltip.style.visibility = 'hidden';
            tooltip.style.display = 'block';
            
            const tooltipRect = tooltip.getBoundingClientRect();
            const viewportWidth = window.innerWidth;
            const viewportHeight = window.innerHeight;
            
            tooltip.style.visibility = 'visible';

            let finalX = e.clientX + 15;
            let finalY = e.clientY + 15;

            if (finalX + tooltipRect.width > viewportWidth - 20) {
                finalX = viewportWidth - tooltipRect.width - 20;
            }
            
            if (finalX < 20) {
                finalX = 20;
            }

            if (finalY + tooltipRect.height > viewportHeight - 20) {
                finalY = viewportHeight - tooltipRect.height - 20;
            }
            
            if (finalY < 20) {
                finalY = 20;
            }

            tooltip.style.left = finalX + 'px';
            tooltip.style.top = finalY + 'px';
        }

        function changeWeek(offset) {
            currentWeekOffset += offset;
            hideTooltip();
            renderCalendar();
        }

        loadEvents();
    </script>
</body>
</html>
